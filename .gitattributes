# Normalise line endings; anything executed inside a Linux container must be LF.
* text=auto
*.sh text eol=lf
*.sql text eol=lf
Dockerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.env.example text eol=lf

# Legacy VB6 sources keep Windows line endings.
*.frm text eol=crlf
*.bas text eol=crlf
*.cls text eol=crlf
*.vbp text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.ico binary
*.rpt binary
